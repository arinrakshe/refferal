# Azure OpenAI — leave blank to run in deterministic keyword-fallback mode.
# Copy this file to .env and fill in your own values. Never commit your real .env.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Port the app serves on
PORT=8000
